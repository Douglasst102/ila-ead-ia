# SAD-ILA — template de variáveis (sem secrets reais)
# Fonte canônica: infrastructure/environments/.env.example
# Uso: cp .env.example .env  (ou copie da pasta environments)

# --- Portas expostas no host (dev) ---
WEB_PORT=3000
API_PORT=3001
POSTGRES_PORT=5432
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MGMT_PORT=15672
OLLAMA_PORT=11434

# --- Web (Next.js) — base REST inclui /api/v1 (integration-specs.md §2.1) ---
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# --- API (NestJS) ---
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000
JWT_SECRET=change-me-dev-only-min-32-chars-long
JWT_ALGORITHM=HS256
JWT_EXPIRES_IN=8h
PASSWORD_PEPPER=change-me-dev-pepper

# --- PostgreSQL ---
POSTGRES_DB=sadila
POSTGRES_USER=sadila
POSTGRES_PASSWORD=change-me-dev-db
DATABASE_URL=postgresql://sadila:change-me-dev-db@postgres:5432/sadila

# --- MinIO (S3-compatible) ---
MINIO_ROOT_USER=sadila-minio
MINIO_ROOT_PASSWORD=change-me-dev-minio
# Porta interna do serviço `minio` no Compose (CloudServer: 8000; MinIO oficial: 9000)
MINIO_ENDPOINT=minio:8000
MINIO_ACCESS_KEY=sadila-minio
MINIO_SECRET_KEY=change-me-dev-minio
MINIO_BUCKET=sadila-documents
MINIO_USE_SSL=false

# --- RabbitMQ ---
RABBITMQ_DEFAULT_USER=sadila
RABBITMQ_DEFAULT_PASS=change-me-dev-rabbit
RABBITMQ_URL=amqp://sadila:change-me-dev-rabbit@rabbitmq:5672

# --- IA (Facade / Ollama — profile `ai`) ---
AI_ENABLED=false
AI_PROVIDER_BASE_URL=http://ollama:11434
AI_API_KEY=
AI_REQUEST_TIMEOUT_MS=120000

# --- Upload / retenção ---
MAX_UPLOAD_MB=50
RETENTION_DAYS=365
